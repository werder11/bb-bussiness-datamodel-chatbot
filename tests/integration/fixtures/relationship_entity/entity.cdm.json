                "entity": {
                  "source": "Contact",
                  "operations": [
                    { "$type": "replaceAsForeignKey", "condition": "referenceOnly", "reference": "contactId" }
                  ]
                }
              },
              {
                "name": "ContactTo",
                "description": "The contact with whom the relationship is established.",
                "isNullable": true,
                "purpose": "hasA",
                "dataType": "entityId",
                "entity": {
                  "source": "Contact",
                  "operations": [
                    { "$type": "replaceAsForeignKey", "condition": "referenceOnly", "reference": "contactId" }
                  ]
                }
              }
            ]
          }
        }
      ]
    }
  ],
