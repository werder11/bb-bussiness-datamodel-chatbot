# Copy to .env and fill in real values. .env is gitignored — never commit it.
# Required only for the semantic-search / LLM-generation query path
# (deterministic structured/traversal answers work without it).

# Which LLM adapter to use — "anthropic" (default) or "gemini" (ADR-0024).
# Gemini has a free tier via https://aistudio.google.com — no card required.
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=
GEMINI_API_KEY=
